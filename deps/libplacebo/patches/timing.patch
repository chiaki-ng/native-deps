+    int num_failed = 0;
+    if (has_failed_dep) {
+        failed[num_failed++] = failed_dep;
+    }
+    bool ret = true;
+    for (int i = 0; i < count; i++) {
+        for (int j = 0; j < num_failed; j++) {
+            vk_cmd_undep(cmds[i], failed[j]);
+        }
+        pl_vulkan_sem sync = cmds[i]->sync;
+        if (!vk_cmd_submit(&cmds[i])) {
+            ret = false;
+            bool seen = false;
+            for (int j = 0; j < num_failed; j++) {
+                seen |= failed[j].sem == sync.sem;
+            }
+            if (!seen && num_failed < PL_ARRAY_SIZE(failed)) {
+                failed[num_failed++] = sync;
+            }
+        }
+    }
+    return ret;
+}
